[MASTER]
ignore=.git,__pycache__,.venv,venv,env,build,dist,htmlcov,reports,security-reports
persistent=no
load-plugins=

[MESSAGES CONTROL]
disable=
    missing-docstring,
    invalid-name,
    too-few-public-methods,
    broad-exception-caught

[FORMAT]
max-line-length=120

[DESIGN]
max-args=6
max-attributes=10
